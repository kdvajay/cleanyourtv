<?xml version="1.0" encoding="utf-8"?>
<com.gathin.tvhome.ContinueWatchingCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cwCardRoot"
    android:layout_width="144dp"
    android:layout_height="80dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_cw_placeholder"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/cwPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:contentDescription="@null" />

    <View
        android:id="@+id/cwGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cw_scrim" />

    <!-- App Name Capsule Badge (e.g. JioHotstar, Netflix, Prime Video) -->
    <TextView
        android:id="@+id/cwBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="6dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1.5dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_cw_badge"
        android:textColor="#E6FFFFFF"
        android:textSize="8sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.03" />

    <!-- Title and Subtitle Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="5dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cwTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="10.5sp"
            android:fontFamily="@string/font_medium"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/cwSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="0.5dp"
            android:textColor="#B3FFFFFF"
            android:textSize="8.5sp"
            android:fontFamily="@string/font_regular"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Progress Track at bottom -->
    <FrameLayout
        android:id="@+id/cwProgressTrack"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:background="#33000000">

        <View
            android:id="@+id/cwProgressFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#00F0FF" />
    </FrameLayout>
</com.gathin.tvhome.ContinueWatchingCardView>
