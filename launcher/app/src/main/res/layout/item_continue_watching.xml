<?xml version="1.0" encoding="utf-8"?>
<com.gathin.tvhome.ContinueWatchingCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cwCardRoot"
    android:layout_width="196dp"
    android:layout_height="110dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_cw_placeholder"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/cwPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/cwGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cw_scrim" />

    <!-- App Name Capsule Badge (e.g. JioHotstar, Netflix, Prime Video) -->
    <TextView
        android:id="@+id/cwBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2.5dp"
        android:background="@drawable/bg_cw_badge"
        android:textColor="#E6FFFFFF"
        android:textSize="9.5sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.04" />

    <!-- Title and Subtitle Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="9dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cwTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/cwSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            android:textColor="#B3FFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="@string/font_regular"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Cyan Progress Track at bottom -->
    <FrameLayout
        android:id="@+id/cwProgressTrack"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:layout_gravity="bottom"
        android:background="#4D000000">

        <View
            android:id="@+id/cwProgressFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#00F0FF" />
    </FrameLayout>
</com.gathin.tvhome.ContinueWatchingCardView>
